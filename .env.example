# Synora Studio Environment Configuration
# Copy this file to '.env' and modify the values as needed.

# ==========================================
# Core Engine & Server Settings
# ==========================================

# Port for the Synora API Server (Default: 5000)
# SYNORA_PORT=5000

# ==========================================
# Authentication & Security Bypass
# ==========================================

# Hardcode the API Key for the Server to bypass the Qt Keychain storage.
# This is useful for headless server deployments where a GUI prompt is impossible.
# SYNORA_API_KEY="your-secret-key-here"

# Completely bypass the CLI Authentication Gate when running server/server.py
# Set to "1" to allow the server to boot without asking for LLM platform credentials.
# Warning: This is strictly for local dev/testing where no outbound LLM calls are made yet.
# ALLOW_UNAUTHENTICATED_SERVER="1"

# ==========================================
# Web Portal (SaaS) Settings
# ==========================================

# Port for the Web SaaS Portal (Default: 8080)
# WEB_PORT=8080

# Environment Mode: 'development' or 'production'
# FLASK_ENV=development
