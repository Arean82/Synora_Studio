     <widget class="QWidget" name="tab_rerank">
      <attribute name="title">
       <string>🔍 Retrieval Reranking</string>
      </attribute>
      <layout class="QVBoxLayout" name="verticalLayout_3">
       <item>
        <widget class="QGroupBox" name="rerank_group">
         <property name="title">
          <string>🔍 Pluggable Two-Stage Reranking</string>
         </property>
         <layout class="QFormLayout" name="formLayout">
          <property name="verticalSpacing">
           <number>10</number>
          </property>
          <item row="0" column="0" colspan="2">
           <widget class="QCheckBox" name="rerank_enable_cb">
            <property name="toolTip">
             <string>Activates secondary cross-encoder scoring to prune and re-order context chunks.</string>
            </property>
            <property name="text">
             <string>Enable Two-Stage Retrieval Reranking (BGE/Cohere)</string>
            </property>
           </widget>
          </item>
          <item row="1" column="0">
